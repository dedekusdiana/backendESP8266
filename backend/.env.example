# Rename jadi .env dan isi dengan connection string Neon (project baru atau yang sama, terserah).
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
PORT=3000

# HiveMQ Cloud (broker MQTT) - dipakai backend untuk PUBLISH tiap ada update,
# supaya ESP8266 yang SUBSCRIBE dapat notifikasi instan.
MQTT_HOST=xxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=dede_smarthome
MQTT_PASSWORD=isi_password_hivemq_kamu
