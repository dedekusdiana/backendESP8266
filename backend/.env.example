# Rename jadi .env dan isi dengan connection string Neon (project baru atau yang sama, terserah).
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
PORT=3000

# HiveMQ Cloud (broker MQTT) - dipakai backend untuk PUBLISH tiap ada update,
# supaya ESP8266 yang SUBSCRIBE dapat notifikasi instan.
MQTT_HOST=xxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=dede_smarthome
MQTT_PASSWORD=isi_password_hivemq_kamu

# Kalau sudah lebih dari sekian detik tanpa heartbeat dari device, dianggap OFFLINE.
OFFLINE_THRESHOLD_SECONDS=35

# Kunci rahasia untuk membuat kode aktivasi tiap device (HMAC). ISI DENGAN TEKS ACAK PANJANG,
# SIMPAN BAIK-BAIK, dan jangan diganti setelah ada alat terjual (kode di stiker bisa jadi tidak berlaku).
# Harus SAMA di .env lokal (untuk scripts/generate-code.js) dan di Environment Variables Vercel.
DEVICE_CODE_SECRET=isi_teks_acak_panjang_minimal_32_karakter

# Kunci admin untuk melihat daftar SEMUA device (GET /api/status & GET /api/data, header X-Admin-Key).
# Kosong = endpoint itu tertutup.
ADMIN_API_KEY=isi_kunci_admin_acak

# Notifikasi Telegram saat relay berubah (manual atau lewat jadwal auto). Opsional -- kalau kosong,
# dilewati diam-diam, fitur lain tetap jalan normal. Lihat README bagian "Notifikasi Telegram".
TELEGRAM_BOT_TOKEN=isi_token_dari_botfather
TELEGRAM_CHAT_ID=isi_chat_id_kamu

# Rahasia webhook Telegram (untuk perintah "cek rumah"). Isi teks acak, hanya huruf/angka/_/- (maks 256).
# Nilai yang sama harus dipakai di parameter secret_token saat setWebhook. Kosong = tidak diverifikasi.
TELEGRAM_WEBHOOK_SECRET=isi_teks_acak_untuk_webhook

# ID device milik kamu. Hanya device ini yang dinotifikasi ke Telegram (relay ON/OFF) dan tampil di
# perintah "cek rumah" (pisah koma kalau lebih dari satu). Kosong = semua device di database ikut.
TELEGRAM_DEVICE_IDS=ESP-A1B2C3

# Push notifikasi FCM ke app Android (relay ON/OFF). Isi dengan ISI FILE JSON service account Firebase
# (Firebase Console -> Project settings -> Service accounts -> Generate new private key), dijadikan SATU BARIS.
# Kosong = push dilewati diam-diam, fitur lain tetap jalan.
FIREBASE_SERVICE_ACCOUNT_JSON=
