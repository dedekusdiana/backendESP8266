<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="2dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/dividerLine"
    app:cardBackgroundColor="@color/cardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="#DCEBFB"
            android:gravity="center"
            android:text="\uD83D\uDD0C"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRelayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/darkNavy"
                tools:text="Relay 1" />

            <ImageButton
                android:id="@+id/btnEditRelayLabel"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit nama relay"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/mutedText" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleRelay"
            android:layout_width="78dp"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="17dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/switchOnBg"
            tools:text="ON" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
