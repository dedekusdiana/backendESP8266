<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#D9E7F2"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle">
            <ImageView
                android:id="@+id/relayIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_relay"
                android:contentDescription="Relay" />
        </FrameLayout>

        <ImageView
            android:id="@+id/relayDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/bg_online_dot"
            android:contentDescription="Relay status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvRelayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/darkNavy"
                tools:text="Relay 1" />
            <ImageButton
                android:id="@+id/btnEditRelayLabel"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="3dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit nama relay"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#9BAAB7" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchRelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            app:thumbTint="@color/cardBackground"
            app:trackTint="@color/switchTrackTint" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
