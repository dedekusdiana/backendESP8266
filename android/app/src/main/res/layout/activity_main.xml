<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/darkNavy"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☰"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Smart Home "
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="IoT"
                                    android:textColor="@color/iconCircleLightBlue"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="MQTT - Neon PostgreSQL - Vercel - Android"
                                android:textColor="#CFE3FA"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📶"
                            android:textSize="22sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Status: Database + Device -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="8dp">

                    <!-- DATABASE STATUS -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDatabaseStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/statusCardBg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="@color/iconCircleTeal"
                                android:gravity="center"
                                android:text="🗄️"
                                android:textSize="15sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="STATUS DATABASE"
                                    android:textSize="9sp"
                                    android:letterSpacing="0.02"
                                    android:textColor="@color/mutedText"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDatabaseStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:background="@drawable/bg_pill"
                                    tools:text="● Connected" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textSize="18sp"
                                android:textColor="@color/mutedText" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- DEVICE STATUS -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDeviceStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/statusCardBg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="@color/iconCircleBlue"
                                android:gravity="center"
                                android:text="📡"
                                android:textSize="15sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="STATUS DEVICE"
                                    android:textSize="9sp"
                                    android:letterSpacing="0.02"
                                    android:textColor="@color/mutedText"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDeviceStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:background="@drawable/bg_pill"
                                    tools:text="● Online" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textSize="18sp"
                                android:textColor="@color/mutedText" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Device selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="8dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/dividerLine"
                            app:cardBackgroundColor="@color/cardBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_icon_circle"
                                    android:backgroundTint="#E3E9F0"
                                    android:gravity="center"
                                    android:text="🖥️"
                                    android:textSize="16sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="DEVICE"
                                        android:textSize="10sp"
                                        android:letterSpacing="0.05"
                                        android:textColor="@color/mutedText"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvSelectedDeviceName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/darkNavy"
                                        tools:text="ESP01_01" />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="▾"
                                    android:textSize="18sp"
                                    android:textColor="@color/mutedText" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <Spinner
                            android:id="@+id/deviceSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:alpha="0" />

                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/btnAddDevice"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Tambah device"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/primaryBlue" />

                    <ImageButton
                        android:id="@+id/btnRemoveDevice"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Hapus device dari app"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="@color/mutedText" />

                </LinearLayout>

                <!-- Ringkasan rumah -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDashboardSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dividerLine"
                    app:cardBackgroundColor="@color/cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RINGKASAN RUMAH"
                            android:textSize="10sp"
                            android:letterSpacing="0.04"
                            android:textStyle="bold"
                            android:textColor="@color/mutedText" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="💡 Lampu"
                                    android:textSize="11sp"
                                    android:textColor="@color/mutedText" />

                                <TextView
                                    android:id="@+id/tvDashLights"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="0 / 4 OFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/darkNavy" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🌡 Suhu"
                                    android:textSize="11sp"
                                    android:textColor="@color/mutedText" />

                                <TextView
                                    android:id="@+id/tvDashTemp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="--°C"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/darkNavy" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🚪 Pintu"
                                    android:textSize="11sp"
                                    android:textColor="@color/mutedText" />

                                <TextView
                                    android:id="@+id/tvDashDoor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="Tutup"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/darkNavy" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="👤 Gerak"
                                    android:textSize="11sp"
                                    android:textColor="@color/mutedText" />

                                <TextView
                                    android:id="@+id/tvDashPir"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="Aman"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/darkNavy" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Suhu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌡️"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SENSOR"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:textColor="@color/mutedText"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="10dp"
                        android:background="@color/dividerLine" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="12dp">

                    <include
                        android:id="@+id/cardSuhu1"
                        layout="@layout/item_suhu_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp" />

                    <include
                        android:id="@+id/cardSuhu2"
                        layout="@layout/item_suhu_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp" />

                    <include
                        android:id="@+id/cardSuhu3"
                        layout="@layout/item_suhu_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp" />

                </LinearLayout>

                <!-- Cuaca -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dividerLine"
                    app:cardBackgroundColor="@color/cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvCuacaIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="@color/iconCircleBlue"
                            android:gravity="center"
                            android:textSize="17sp"
                            tools:text="☀️" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerLine" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="KONDISI CUACA"
                                android:textSize="10sp"
                                android:letterSpacing="0.03"
                                android:textColor="@color/mutedText"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCuacaValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/darkNavy"
                                tools:text="Cerah" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="@color/mutedText" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sensorRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:nestedScrollingEnabled="false" />

                <!-- Auto (jadwal lampu) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏰"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUTO (JADWAL LAMPU)"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:textColor="@color/mutedText"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@color/dividerLine" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/autoRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Relay list -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KONTROL RELAY"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:textColor="@color/mutedText"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@color/dividerLine" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/relayRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvLastUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:textSize="12sp"
                    android:textColor="@color/mutedText"
                    tools:text="Update terakhir: 17 Sep 2026, 16:12:38 WIB" />

                <TextView
                    android:id="@+id/tvConnectionInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="4dp"
                    android:textSize="12sp"
                    android:textColor="@color/mutedText"
                    tools:text="Terhubung ke server" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_anchor="@id/swipeRefresh"
        app:layout_anchorGravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

